# ── 기본 ──────────────────────────────────────────────
# 공개 QR/참여/Twitch 복귀 기준 URL은 Firebase Hosting을 사용
BASE_URL=https://hackathon-korean-team5.web.app/
PUBLIC_JOIN_URL=https://hackathon-korean-team5.web.app/join
TWITCH_REDIRECT_URI=https://hackathon-korean-team5.web.app/join

# /admin?token=<이 값> 으로 접속
ADMIN_TOKEN=streamdrop

# 세션 쿠키 서명 키 — 데모라도 임의 문자열로 교체 권장
SECRET_KEY=dev-secret-change-me

# 서버 디버그 모드. 참가자는 항상 Twitch OAuth로 로그인
DEBUG=0

# ── Twitch OAuth (참가자 로그인) ───────────────────────
# https://dev.twitch.tv/console/apps 에서 앱 생성
# Twitch Console Redirect URLs must include:
# https://hackathon-korean-team5.web.app/join
# https://hackathon-korean-team5.web.app/join/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Twitch 귓속말 발신 계정 (best-effort 경로) ─────────
# 전화번호 인증된 계정으로: twitch token -u -s user:manage:whispers
TWITCH_BOT_USER_ID=
TWITCH_BOT_TOKEN=

# ── SodaGift (sandbox) ────────────────────────────────
# 미설정 시 mock 링크 발급. sandbox 키(sodagift_test_...) 넣으면 실연동 전환
SODAGIFT_API_KEY=
SODAGIFT_BASE_URL=https://biz-sandbox-api.sodagift.com
GIFT_SENDER_NAME=StreamDrop

# ── Firebase ↔ SodaGift 지급 브리지 ───────────────────
# Web API key는 공개 식별자이며 hosting/js/firebase-config.js와 같은 값
FIREBASE_PROJECT_ID=hackathon-korean
FIREBASE_WEB_API_KEY=AIzaSyDLJZCsHtidnHpOEeEUqT1aX1kdYO8Yz7A
FIRESTORE_EVENT_DOCUMENT=events/live
FIRESTORE_POLL_INTERVAL=1.5
