# Secrets/config for local dev. See also `.env` (holds DATABASE_URL, read by the Prisma CLI).
# .env and .env.local are git-ignored; .env.example is committed.

# --- App ---
APP_URL=http://localhost:3000

# --- Database (PostgreSQL via docker-compose.yml) — put this in .env ---
DATABASE_URL=postgresql://sodagift:sodagift@localhost:5432/sodagift?schema=public

# --- Twitch OIDC (participant identity proof — CLAUDE.md §17) ---
# From https://dev.twitch.tv/console/apps  (Client Type: Confidential).
# Do NOT commit real values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Endpoints have safe defaults in src/lib/env.ts; override only if needed.
TWITCH_OIDC_ISSUER=https://id.twitch.tv/oauth2
TWITCH_AUTHORIZE_URL=https://id.twitch.tv/oauth2/authorize
TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
TWITCH_JWKS_URI=https://id.twitch.tv/oauth2/keys
TWITCH_VALIDATE_URL=https://id.twitch.tv/oauth2/validate
TWITCH_HELIX_BASE=https://api.twitch.tv/helix

# --- Host Twitch OAuth (scope user:manage:whispers — SEPARATE from participant OIDC) ---
# Its origin must match APP_URL. Add this exact URL to the app's OAuth Redirect URLs too.
TWITCH_HOST_REDIRECT_URI=http://localhost:3000/api/auth/host/callback

# --- Crypto ---
# JWE key for the short-lived state/nonce + proof cookies (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_STATE_SECRET=

# --- SodaGift (unused by the OIDC proof; kept for later phases) ---
SODAGIFT_BASE_URL=https://biz-sandbox-api.sodagift.com
SODAGIFT_API_KEY=
SODAGIFT_SENDER_NAME=SodaGift Live
